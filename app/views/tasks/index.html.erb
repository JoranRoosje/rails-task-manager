<h1>TASKS</h1>

<ul>
  <% @tasks.each do |task| %>
    <li><%= task.completed ? "[X]" : "[ ]" %> <%= link_to task.title, task_path(task) %>: <%= task.details %>
        <%= link_to "Delete", task_path(task), data:{turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
    </li>
  <% end %>
</ul>

<div>
  <%= link_to "Add a new task", new_task_path %>
</div>
