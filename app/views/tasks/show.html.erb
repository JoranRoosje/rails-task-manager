<div class="d-flex justify-content-between mb-4 mt-1"><h1><%= @task.title %></h1><%= link_to "Edit this task", edit_task_path(@task), class: "btn btn-primary d-inline-flex align-items-center justify-content-center" %></div>
<div class="card mb-2">
  <div class="card-body">
    <%= @task.details %>
  </div>
</div>

<div>
  <input type="checkbox" <%= 'checked' if @task.completed %>>
  <%= @task.completed ? 'This task is completed' : 'This task is not completed yet' %>
</div>
<%= link_to "Back to list", tasks_path %>
